# Copy this file to .env (never commit .env).
#
# Expo reads EXPO_PUBLIC_* variables at bundle time.
# After changing .env, restart the dev server (stop npm run web and start again).
#
# Quick start:
#   1. Backend running on port 8000 (./scripts/run-backend.sh)
#   2. cp env.example .env
#   3. npm run web

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# FastAPI base URL (no trailing slash).

# Expo Web on the same machine as the backend:
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Physical phone on the same Wi‑Fi (replace with your Mac LAN IP, not 127.0.0.1):
# EXPO_PUBLIC_API_URL=http://192.168.1.42:8000
