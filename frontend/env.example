# Copy to .env (never commit .env).
# Restart the dev server after changes.

# FastAPI base URL (no trailing slash)
VITE_API_URL=http://127.0.0.1:8000

# Unlock non-critical routes without login in dev (/profile and /admin always require auth)
# VITE_DEV_UNLOCK_ROUTES=false

# Pinned 3D cinematic hero on home (default off — set true to re-enable)
# VITE_CINEMATIC_HERO_ENABLED=true
