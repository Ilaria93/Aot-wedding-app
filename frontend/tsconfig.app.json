{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/**/__tests__/**",
    "src/components/cinematic/**",
    "src/scenes/**",
    "src/data/**",
    "src/contexts/HeroScrollContext.tsx",
    "src/constants/cameraPathEditorColors.ts",
    "src/constants/cinematicModelRegistry.ts",
    "src/constants/cinematicSceneCaptions.ts",
    "src/constants/countdownTransition.ts",
    "src/constants/grayboxPalette.ts",
    "src/constants/heroScroll.ts",
    "src/constants/odmGear.ts",
    "src/constants/operationRavennaGraybox.ts",
    "src/constants/operationRavennaTimeline.ts",
    "src/constants/squadTraversalManeuvers.ts",
    "src/constants/titanCorridorTitan.ts",
    "src/constants/titanCorridorTitanConfig.ts",
    "src/constants/titanPreviewAssets.ts",
    "src/constants/titanPreviewConfig.ts",
    "src/hooks/useCameraPathEditorHelpers.ts",
    "src/hooks/useCoupleStrikeSequence.ts",
    "src/hooks/useGsapTimeline.ts",
    "src/hooks/useGsapTimeline.web.ts",
    "src/hooks/useOperationRavennaDebugOverlay.ts",
    "src/hooks/usePrefersReducedMotion.ts",
    "src/hooks/usePrefersReducedMotion.web.ts",
    "src/hooks/useScrollProgress.ts",
    "src/hooks/useScrollProgress.types.ts",
    "src/hooks/useScrollProgress.web.ts",
    "src/hooks/useWeddingCountdown.ts",
    "src/utils/**",
    "src/types/cameraPathEditor.ts",
    "src/types/cameraRig.ts",
    "src/types/cinematicDebug.ts",
    "src/types/coupleStrike.ts",
    "src/types/odmCamera.ts",
    "src/types/scene.ts",
    "src/types/sceneTimeline.ts",
    "src/types/squadTraversal.ts",
    "src/types/titanPreview.ts",
    "src/types/gltfAssets.d.ts",
    "src/types/react-native-shim.d.ts"
  ]
}
