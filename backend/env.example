# Copy this file to .env and customize (never commit .env).

# Required for POST /guest/create-invite and all /admin/* routes.
ADMIN_API_KEY=your-long-random-secret-here

# Optional: comma-separated browser origins allowed to call this API during development.
# Use * only for debugging (disables credential cookies compatibility with browsers).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8081
