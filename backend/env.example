# Copy this file to .env and customize (never commit .env).

# Required for POST /guest/create-invite and all /admin/* routes.
ADMIN_API_KEY=your-long-random-secret-here

# Optional: comma-separated browser origins allowed to call this API during development.
# Use * only for debugging (disables credential cookies compatibility with browsers).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# Required for photo upload signing when using the album feature.
S3_BUCKET_NAME=your-wedding-photos-bucket
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional for S3-compatible providers or CDN/public buckets.
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=

# Optional photo upload tuning.
PHOTO_UPLOAD_URL_EXPIRES_SECONDS=900
PHOTO_MAX_UPLOAD_BYTES=10485760
