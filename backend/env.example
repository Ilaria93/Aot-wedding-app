# Copy this file to .env and customize (never commit .env).
#
# Quick start:
#   1. docker compose up -d postgres   (from project root)
#   2. cp env.example .env
#   3. Set JWT_SECRET_KEY to a long random string
#   4. ./venv/bin/alembic -c alembic.ini upgrade head
#   5. ./venv/bin/uvicorn main:app --reload
#
# Or use: ./scripts/run-dev.sh (backend + frontend Vite insieme)

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Default matches docker-compose.yml (user: postgres, password: postgres).
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/aot_wedding_app

# Used by pytest only; keep separate from the app database.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/aot_wedding_app_test

# -----------------------------------------------------------------------------
# Auth (required)
# -----------------------------------------------------------------------------
# Required. Auth endpoints return 503 if empty. Use a long random value in production.
JWT_SECRET_KEY=replace-this-with-a-long-random-secret

# Optional token lifetimes.
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=30
SHORT_SESSION_REFRESH_TOKEN_EXPIRES_HOURS=24

# Secret required to register as admin (spouses). Leave empty to disable admin self-registration.
WEDDING_ROLE_SECRET=example

# -----------------------------------------------------------------------------
# CORS (optional)
# -----------------------------------------------------------------------------
# Comma-separated browser origins for Vite during development.
# If omitted, settings.py uses sensible localhost defaults.
# Use * only for quick debugging (not recommended with credentials).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Photo album / S3 (required only for guest photo uploads)
# -----------------------------------------------------------------------------
S3_BUCKET_NAME=your-wedding-photos-bucket
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: S3-compatible providers (MinIO, R2, etc.) or CDN base URL for public photos.
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=

# Presigned upload URL lifetime (seconds) and max file size (bytes, default 10 MB).
PHOTO_UPLOAD_URL_EXPIRES_SECONDS=900
PHOTO_MAX_UPLOAD_BYTES=10485760
